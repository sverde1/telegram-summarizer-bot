# Required
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated Telegram user ids allowed to use the bot. Leave empty to start in setup mode:
# the bot then replies to anyone with their user id and does nothing else.
ALLOWED_USER_IDS=

# Claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
SUMMARY_LANGUAGE=English

# Speech-to-text. For a GPU: WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16, WHISPER_MODEL=medium,
# pip install nvidia-cublas-cu12 nvidia-cudnn-cu12, and set LD_LIBRARY_PATH in the service unit.
# Use multilingual models only (not *.en): forcing English on non-English audio invents text.
WHISPER_DEVICE=cpu
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0

# Limits
MAX_DURATION_MIN=180
MAX_FRAMES=16
