# Required
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids of admins. Admins approve other users from Telegram (stored in
# data/bot.sqlite3). Leave empty to start in setup mode: the bot replies to anyone with their user id
# and does nothing else.
ADMIN_USER_IDS=

# Default LLM (users can pick another provider/model with /models):
#   codex        ChatGPT subscription via Codex CLI, sandboxed with bubblewrap (default).
#                One-time login for the bot: CODEX_HOME=<repo>/data/codex-home codex login --device-auth
#   claude-code  Claude subscription via the Claude Code CLI, all tools disabled.
#   api          Anthropic API; needs ANTHROPIC_API_KEY.
#   openai-api   OpenAI API; needs OPENAI_API_KEY (billed per token, unlike the ChatGPT plan).
LLM_BACKEND=codex
SUMMARY_LANGUAGE=English
# Codex default model (users can pick another with /models). Empty = Codex's own default.
CODEX_MODEL=gpt-6-sol
CODEX_EFFORT=medium
CLAUDE_CODE_MODEL=claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-6-sol
OPENAI_EFFORT=medium
OPENAI_API_KEY=

# Speech-to-text. For a GPU: WHISPER_DEVICE=cuda, WHISPER_COMPUTE_TYPE=float16, WHISPER_MODEL=medium,
# pip install nvidia-cublas-cu12 nvidia-cudnn-cu12, and set LD_LIBRARY_PATH in the service unit.
# Use multilingual models only (not *.en): forcing English on non-English audio invents text.
WHISPER_DEVICE=cpu
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0

# Limits
MAX_DURATION_MIN=180
# Whisper may use at most this share of RAM; a video that doesn't fit right now waits (other videos go
# first) for up to WHISPER_RAM_WAIT_MIN minutes, with a button to stop waiting
WHISPER_RAM_FRACTION=0.5
WHISPER_RAM_WAIT_MIN=60
# Per non-admin user: videos queued or running at once; total queue size; minutes before the same user
# may /again the same video again
MAX_QUEUED_PER_USER=3
MAX_QUEUE=20
# Jobs worked on at the same time (lookups, downloads and AI calls run side by side; Whisper, OCR, frame sweeps
# and voice messages take turns on the CPU).
WORKERS=8
AGAIN_COOLDOWN_MIN=10
# Links a non-admin may send per rolling 24 h (0 = no limit). Only the starting value: once an admin uses
# /limit in Telegram, the value stored in the database wins.
DAILY_LIMIT=100
# Uploaded documents: the most pages / characters read from one file.
MAX_DOC_PAGES=2000
MAX_DOC_CHARS=3000000
# Characters of book text sent to the AI per call; longer books/chapters are summarized in pieces.
BOOK_CHUNK_CHARS=300000
# AI calls for one book that run side by side (chapter batches).
BOOK_PARALLEL=3
# Scanned PDFs: auto (Tesseract on the CPU, RapidOCR on a GPU), tesseract (sudo apt install tesseract-ocr)
# or rapidocr (pip, can use a GPU).
OCR_ENGINE=auto
# cpu, or cuda for an NVIDIA GPU (RapidOCR; needs onnxruntime-gpu, else falls back to the CPU).
OCR_DEVICE=cpu
# Scans a user may have read per 24 h (0 = no limit); /limit ocr changes it at runtime.
OCR_DAILY_LIMIT=5
# Longest scan (pages needing OCR) read without an admin's approval.
OCR_MAX_PAGES=400
OCR_WORKERS=3
# Largest document downloaded from a Google Drive / Dropbox link (MB).
MAX_LINK_DOWNLOAD_MB=100
# Largest audio/video file downloaded from such a link (MB).
MAX_MEDIA_LINK_MB=1024
# The system's espeak-ng for voice messages (sudo apt install espeak-ng-data); Debian/Ubuntu x86-64 paths.
ESPEAK_LIB=/usr/lib/x86_64-linux-gnu/libespeak-ng.so.1
ESPEAK_DATA=/usr/lib/x86_64-linux-gnu/espeak-ng-data
# Voice messages (🔊 Listen) with Kokoro. TTS_VOICE empty = the default voice for SUMMARY_LANGUAGE.
TTS_VOICE=
TTS_SPEED=1.0
TTS_DEVICE=cpu
# Days a made voice message is reused (Telegram keeps it; only its id is stored).
VOICE_CACHE_DAYS=7
# New voice messages a user may have made per 24 h (0 = no limit; reused ones are free).
TTS_DAILY_LIMIT=20
# Follow-up questions (💬 Ask) a user may ask per 24 h (0 = no limit; /limit ask changes it).
ASK_DAILY_LIMIT=20
# Most a question may send to the AI in characters (summary, earlier answers, transcript or book text);
# default: BOOK_CHUNK_CHARS. Longer material is cut; a long book falls back to its summaries.
#ASK_MAX_CHARS=300000
# Longest question accepted, in characters.
ASK_MAX_QUESTION=1000
# Default units in summaries (users change theirs with /units): metric|imperial, c|f.
UNIT_SYSTEM=metric
TEMPERATURE=c
MAX_FRAMES=16
# When frames are grabbed, videos up to this long are also sampled every ~2 s
SHORT_VIDEO_SEC=180
# TikTok photo carousels: max slides sent to the LLM
MAX_SLIDES=35
